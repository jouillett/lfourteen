{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/manage/layout,_N_T_/manage/person/layout,_N_T_/manage/person/page,_N_T_/manage/person"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/manage/person/__PAGE__",
    "/manage/person",
    "/manage",
    "/_index",
    "/_head"
  ]
}